#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
backend_dir="$repo_root/backend"
config_file="$backend_dir/.env.development"
config_example="$backend_dir/.env.development.example"
compose_files=(-f "$backend_dir/compose.yaml" -f "$backend_dir/compose.dev.yaml")
state_dir="$repo_root/.local/dev-local"
serve_state_file="$state_dir/serve"
local_url="http://localhost:5173"
pwa_local_port="${PAL_DEV_PWA_PORT:-14173}"
pwa_local_url="http://localhost:$pwa_local_port"
command_name="${1:-up}"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

ensure_config() {
  if [[ ! -f "$config_file" ]]; then
    cp "$config_example" "$config_file"
    chmod 600 "$config_file"
    echo "Created $config_file from the development template."
  fi
}

load_serve_state() {
  public_url="$local_url"
  allowed_host=""
  serve_host=""
  serve_port="${PAL_DEV_SERVE_PORT:-8444}"
  managed_serve=false

  if [[ -s "$serve_state_file" ]]; then
    local stored_url stored_host stored_port stored_local_port
    stored_url="$(sed -n '1p' "$serve_state_file")"
    stored_host="$(sed -n '2p' "$serve_state_file")"
    stored_port="$(sed -n '3p' "$serve_state_file")"
    stored_local_port="$(sed -n '4p' "$serve_state_file")"
    if [[ -n "$stored_url" && -n "$stored_host" && "$stored_port" =~ ^[0-9]+$ && "$stored_local_port" =~ ^[0-9]+$ ]]; then
      public_url="$stored_url"
      serve_host="$stored_host"
      serve_port="$stored_port"
      pwa_local_port="$stored_local_port"
      pwa_local_url="http://localhost:$pwa_local_port"
      managed_serve=true
    fi
  fi
}

tailnet_dns_name() {
  tailscale status --json | node -e '
    let input = "";
    process.stdin.on("data", (chunk) => (input += chunk));
    process.stdin.on("end", () => {
      const name = JSON.parse(input).Self?.DNSName;
      if (!name) process.exit(1);
      process.stdout.write(name.replace(/\.$/, ""));
    });
  '
}

serve_proxy_for() {
  tailscale serve status --json | node -e '
    let input = "";
    process.stdin.on("data", (chunk) => (input += chunk));
    process.stdin.on("end", () => {
      const status = JSON.parse(input);
      const key = process.argv[1];
      process.stdout.write(status.Web?.[key]?.Handlers?.["/"]?.Proxy ?? "");
    });
  ' "$1"
}

write_serve_state() {
  mkdir -p "$state_dir"
  printf '%s\n%s\n%s\n%s\n' "$1" "$2" "$3" "$4" >"$serve_state_file"
  chmod 600 "$serve_state_file"
}

wait_for_url() {
  local url="$1"
  local attempt
  for attempt in {1..60}; do
    if curl --fail --silent --show-error "$url" >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done
  echo "Timed out waiting for $url" >&2
  return 1
}

compose() {
  PAL_ENV_FILE="$config_file" \
  POSTGRES_PORT="${PAL_DEV_POSTGRES_PORT:-15433}" \
  PAL_DEV_PUBLIC_URL="$public_url" \
  PAL_DEV_ALLOWED_HOST="$allowed_host" \
  PAL_DEV_PWA_PORT="$pwa_local_port" \
    docker compose --project-name pal-dev "${compose_files[@]}" "$@"
}

start_pwa_stage() {
  if ! curl --fail --silent --show-error "$local_url/api/health" >/dev/null; then
    echo "The local development backend is not healthy. Run ./scripts/dev-local up first." >&2
    return 1
  fi
  compose up -d --build --wait --no-deps web
  wait_for_url "$pwa_local_url/health"
}

publish_pwa_update() {
  local revision
  revision="$(compose images -q web)"
  if [[ -z "$revision" ]]; then
    echo "Pal Dev PWA was rebuilt, but its frontend revision could not be determined." >&2
    return
  fi
  if ! curl --fail --silent --show-error \
    --request POST \
    --header 'Content-Type: application/json' \
    --data "{\"revision\":\"$revision\"}" \
    "$local_url/api/frontend-updates" \
    >/dev/null; then
    echo "Pal Dev PWA was rebuilt, but the live update notice failed." >&2
  fi
}

prepare() {
  require_command docker
  ensure_config
  load_serve_state
}

case "$command_name" in
  config)
    prepare
    compose config --quiet
    echo "Compose configuration is valid. Services:"
    compose config --services
    ;;
  login)
    prepare
    compose build agent-service
    compose run --rm --no-deps agent-service node dist/agent/login.js --device
    ;;
  up)
    prepare
    compose build agent-service execution web
    compose up -d --wait postgres
    compose run --rm --no-deps agent-service node dist/database/migrate.js
    if ! compose run --rm --no-deps agent-service sh -c 'test -s "$PAL_AGENT_AUTH_PATH"'; then
      echo "Development agent login is required. Run:" >&2
      echo "  ./scripts/dev-local login" >&2
      exit 2
    fi
    compose up -d --wait execution agent-service web frontend
    echo "Pal development is available at $local_url"
    ;;
  rebuild)
    prepare
    compose build agent-service
    compose up -d --wait postgres
    compose run --rm --no-deps agent-service node dist/database/migrate.js
    compose up -d --wait --no-deps --force-recreate agent-service web frontend
    echo "Pal development is available at $local_url"
    ;;
  execution-rebuild)
    prepare
    compose build execution
    compose up -d --wait --no-deps --force-recreate execution
    compose restart agent-service web
    ;;
  frontend-restart)
    prepare
    require_command curl
    compose restart frontend
    wait_for_url "$local_url"
    echo "Pal frontend dependencies are refreshed at $local_url"
    ;;
  logs)
    prepare
    compose logs -f agent-service execution web frontend
    ;;
  status)
    prepare
    compose ps
    echo "Pal development URL: $local_url"
    if compose ps --status running --services | grep -qx web; then
      echo "Pal PWA staging URL: $pwa_local_url"
      if [[ "$managed_serve" == true ]]; then
        echo "Pal Tailnet PWA URL: $public_url"
      fi
    fi
    ;;
  serve)
    prepare
    require_command curl
    require_command node
    require_command tailscale
    start_pwa_stage
    tailnet_dns="$(tailnet_dns_name)"
    desired_proxy="http://127.0.0.1:$pwa_local_port"
    existing_proxy="$(serve_proxy_for "$tailnet_dns:$serve_port")"
    if [[ -n "$existing_proxy" && "$existing_proxy" != "$desired_proxy" ]]; then
      echo "Tailscale Serve port $serve_port already proxies $existing_proxy; refusing to replace it." >&2
      exit 1
    fi
    if [[ -z "$existing_proxy" ]]; then
      tailscale serve --yes --bg --https="$serve_port" "$desired_proxy"
    fi
    tailnet_url="https://$tailnet_dns:$serve_port"
    write_serve_state "$tailnet_url" "$tailnet_dns" "$serve_port" "$pwa_local_port"
    load_serve_state
    compose up -d --wait --no-deps --force-recreate agent-service web frontend
    wait_for_url "$public_url/api/health"
    publish_pwa_update
    echo "Pal Dev Tailnet PWA is available at $public_url"
    ;;
  unserve)
    prepare
    require_command curl
    require_command node
    require_command tailscale
    if [[ "$managed_serve" != true ]]; then
      echo "No script-managed Tailscale Serve route is recorded; refusing to alter Serve configuration." >&2
      exit 1
    fi
    expected_proxy="http://127.0.0.1:$pwa_local_port"
    existing_proxy="$(serve_proxy_for "$serve_host:$serve_port")"
    if [[ -n "$existing_proxy" && "$existing_proxy" != "$expected_proxy" ]]; then
      echo "Tailscale Serve port $serve_port no longer belongs to Pal development; refusing to remove it." >&2
      exit 1
    fi
    if [[ -n "$existing_proxy" ]]; then
      tailscale serve --yes --https="$serve_port" off
    fi
    rm "$serve_state_file"
    load_serve_state
    compose up -d --wait --no-deps --force-recreate agent-service web frontend
    wait_for_url "$local_url/api/health"
    echo "Pal Tailnet Serve is disabled; local development remains at $local_url"
    ;;
  pwa-up)
    prepare
    require_command curl
    start_pwa_stage
    publish_pwa_update
    echo "Pal Dev PWA staging is available at $pwa_local_url"
    ;;
  down)
    prepare
    compose down
    ;;
  *)
    echo "Usage: ./scripts/dev-local {config|login|up|rebuild|execution-rebuild|frontend-restart|logs|status|serve|unserve|pwa-up|down}" >&2
    exit 2
    ;;
esac
