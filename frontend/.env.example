# Backend URL used by the Vite development and preview proxy.
PAL_BACKEND_URL=http://127.0.0.1:3000
# Must match the backend for a production-style full-stack deployment.
PAL_RELEASE_ID=development

# noVNC HTTP/WebSocket target, reachable from Vite.
PAL_DESKTOP_URL=http://127.0.0.1:6080

# Use Pal Dev metadata for a production-style staging install.
# PAL_APP_VARIANT=dev
