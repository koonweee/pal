{
  "name": "pal-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "npm run check && vite build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:pwa": "npm run build && node scripts/check-pwa.mjs && playwright test -c playwright.pwa.config.ts",
    "check:ui": "node scripts/check-ui-architecture.mjs",
    "trim": "knip --config knip.json --production --include files,dependencies,unlisted,binaries,duplicates",
    "preview": "vite preview",
    "test": "playwright test",
    "format": "prettier --write src/ test/ test-pwa/ test-unit/ scripts/ *.ts *.json index.html"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tanstack/react-virtual": "^3.14.21",
    "@use-gesture/react": "^10.3.1",
    "dompurify": "3.4.16",
    "lucide-react": "^0.554.0",
    "marked": "18.1.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^27.4.0",
    "knip": "^6.16.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
