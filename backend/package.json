{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/ && npm run check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "npm run build && vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/database/migrate.js",
    "openapi:generate": "npm run build && node scripts/generate-openapi.mjs",
    "openapi:check": "npm run build && node scripts/check-openapi.mjs",
    "pretest": "npm run build",
    "pretest:e2e": "npm run build",
    "agent:login": "npm run build && node dist/agent/login.js",
    "agent:smoke": "npm run build && node scripts/agent-smoke.mjs",
    "preferences:smoke": "npm run build && node scripts/preferences-smoke.mjs",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "workers:smoke": "node scripts/browser-smoke.mjs --workers",
    "files:smoke": "npm run build && node scripts/files-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.124",
    "@mastra/code-sdk": "1.10.1",
    "@mastra/core": "1.76.0",
    "@mastra/mcp": "2.1.2",
    "@mastra/memory": "1.37.0",
    "@mastra/pg": "1.29.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "agent-browser": "0.38.2",
    "ai": "6.0.300",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "content-disposition": "^3.0.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "file-type": "22.1.1",
    "marked": "18.0.5",
    "pg": "^8.23.1",
    "playwright-core": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
