DATABASE_URL=postgresql://pal:pal@localhost:15433/pal
TEST_DATABASE_URL=postgresql://pal:pal@localhost:15433/pal_test
PORT=3000
HOST=127.0.0.1
PAL_UPLOAD_DIR=./data/uploads

# Main, Task Agent, and memory models use the login stored in the isolated
# pal-dev data volume. No API key is required.
PAL_AGENT_MODEL=gpt-6.1-sol
PAL_AGENT_THINKING_EFFORT=medium
PAL_AGENT_AUTH_PATH=./data/agent/auth.json
PAL_AGENT_WORKING_DIR=./data/workspace

# The local development overlay supplies the browser-facing URL.
PAL_PUBLIC_URL=http://localhost:5173
PAL_MCP_CATALOG_WARN_PERCENT=10

# Compose supplies the X11 settings and enables desktop tools.
PAL_DESKTOP_ENABLED=false
PAL_DESKTOP_PORT=6080
PAL_BROWSER_PORT=9222

# Telegram and APNs are intentionally absent. Use dedicated development
# credentials only when a test specifically requires those delivery paths.

# Optional Web Push with a dedicated development VAPID pair; retain it across releases.
# Generate once from backend/: npx web-push generate-vapid-keys
# PAL_WEB_PUSH_PUBLIC_KEY=
# PAL_WEB_PUSH_PRIVATE_KEY=
# PAL_WEB_PUSH_SUBJECT=mailto:owner@example.com
