DATABASE_URL=postgresql://pal:pal@localhost:5433/pal
TEST_DATABASE_URL=postgresql://pal:pal@localhost:5433/pal_test
PORT=3000
HOST=127.0.0.1
PAL_UPLOAD_DIR=/data/private/uploads
# Shared opaque identifier for the deployed backend and frontend build.
PAL_RELEASE_ID=development

# Optional secondary owner DM. Configure both values to enable Telegram.
# PAL_TELEGRAM_BOT_TOKEN=
# PAL_TELEGRAM_OWNER_ID=

# Optional APNs delivery. Configure all values together.
# PAL_APNS_TEAM_ID=
# PAL_APNS_KEY_ID=
# PAL_APNS_PRIVATE_KEY=
# PAL_APNS_TOPIC=com.example.pal
# PAL_APNS_ENVIRONMENT=production

# Main, Task Agent, and memory models use ChatGPT login, saved privately by npm run agent:login.
PAL_AGENT_MODEL=gpt-6.1-sol
PAL_AGENT_THINKING_EFFORT=medium
PAL_AGENT_AUTH_PATH=/data/private/agent/auth.json
PAL_AGENT_WORKING_DIR=/home/pal/workspace
# Stable Compose label for the single persistent execution container.
PAL_EXECUTION_ID=pal-execution
# Linux hosts: group ID of /var/run/docker.sock (Docker Desktop defaults to 0).
PAL_DOCKER_GID=0

# Browser-accessible API origin; register <origin>/mcp/oauth/callback with OAuth providers.
PAL_PUBLIC_URL=http://localhost:8080
# Full available MCP catalog warning percentage; token counts use characters/4.
# Progressive discovery includes only loaded MCP signatures in task prompts.
PAL_MCP_CATALOG_WARN_PERCENT=10
# Context limit override. gpt-6.1-sol falls back to 272000; other models report unknown.
# PAL_AGENT_CONTEXT_WINDOW_TOKENS=

# Compose supplies desktop execution; host-side builds/tests do not execute agent tools.
PAL_DESKTOP_ENABLED=false
# Optional browser-accessible viewer URL returned by native screen-info tools.
# PAL_DESKTOP_VIEWER_URL=http://127.0.0.1:5173/desktop/v2/vnc.html

# Service-side browser control uses the private web gateway; raw CDP is not published.
PAL_BROWSER_ENDPOINT=http://web:8081
# Optional Web Push. Configure all values together; retain keys across releases.
# Generate once: npx web-push generate-vapid-keys
# PAL_WEB_PUSH_PUBLIC_KEY=
# PAL_WEB_PUSH_PRIVATE_KEY=
# PAL_WEB_PUSH_SUBJECT=mailto:owner@example.com

# A sanitized legacy root-filesystem image preserves packages installed outside home.
# Set in the Compose interpolation environment after offline migration.
# PAL_EXECUTION_BASE=pal-execution-preserved:cutover
# PAL_EXECUTION_IMAGE=pal-execution:cutover
# PAL_EXECUTION_HOSTNAME=pal
