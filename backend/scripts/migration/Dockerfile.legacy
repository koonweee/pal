FROM pal-execution-local
USER root
RUN apt-get update && apt-get install -y --no-install-recommends jq && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/user-installed \
    && printf '#!/bin/sh\necho preserved-utility\n' > /opt/user-installed/utility \
    && chmod +x /opt/user-installed/utility \
    && rm -f /data/home /data/workspace /data/uploads \
    && mkdir -p /data/home /data/workspace /data/uploads /data/agent \
    && chown -R pal:pal /data \
    && usermod -d /data/home pal \
    && printf 'fixture-backend-secret-keep-private' > /opt/pal/backend-secret
ENV HOME=/data/home DATABASE_URL=postgresql://fixture-private-database/legacy \
    FIXTURE_API_TOKEN=fixture-backend-secret-keep-private
USER pal
